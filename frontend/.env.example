# Where the Next.js server reaches Strapi (server-side only)
STRAPI_URL=http://localhost:1337

# Optional: read-only Strapi API token. Not needed with the default public read permissions.
STRAPI_API_TOKEN=

# Public URL of this website (used for canonical URLs and sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Must match LEAD_FORM_SECRET in backend/.env
LEAD_FORM_SECRET=change-me-lead-secret

# Must match REVALIDATE_SECRET in backend/.env (Strapi pings /api/revalidate on every content change)
REVALIDATE_SECRET=change-me-revalidate

# Optional: comma-separated image hosts if Strapi media is moved to S3/Cloudinary etc.
IMAGE_HOSTS=
