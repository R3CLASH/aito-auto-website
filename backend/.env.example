# Copy to .env (or run `npm run setup` in the project root, which fills in random secrets).

# Server
HOST=0.0.0.0
PORT=1337
# Public URL of the CMS in production, e.g. https://cms.aitoauto.fi (leave empty locally)
PUBLIC_URL=

# Secrets – generate unique random values for every environment
APP_KEYS=toBeModified1,toBeModified2,toBeModified3,toBeModified4
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified

# Database (PostgreSQL)
DATABASE_CLIENT=postgres
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=aito_auto
DATABASE_USERNAME=aito
DATABASE_PASSWORD=aito
DATABASE_SSL=false

# Website integration
# Where the Next.js site runs – Strapi pings FRONTEND_URL/api/revalidate after every content change
FRONTEND_URL=http://localhost:3000
# Must match REVALIDATE_SECRET in frontend/.env.local
REVALIDATE_SECRET=tobemodified
# Must match LEAD_FORM_SECRET in frontend/.env.local
LEAD_FORM_SECRET=tobemodified

# Load the demo content (cars, pages, settings) when the database is empty
SEED_DEMO_DATA=true
