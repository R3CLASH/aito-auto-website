{
  "kind": "collectionType",
  "collectionName": "services",
  "info": {
    "singularName": "service",
    "pluralName": "services",
    "displayName": "Palvelu (Service)"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "order": {
      "type": "integer",
      "default": 0
    },
    "summary": {
      "type": "string"
    },
    "body": {
      "type": "text"
    },
    "facts": {
      "type": "component",
      "component": "shared.key-value",
      "repeatable": true
    },
    "special": {
      "type": "enumeration",
      "enum": [
        "none",
        "trade-in-form"
      ],
      "default": "none"
    },
    "ctaLabel": {
      "type": "string"
    },
    "ctaUrl": {
      "type": "string"
    }
  }
}
