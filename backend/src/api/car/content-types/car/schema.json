{
  "kind": "collectionType",
  "collectionName": "cars",
  "info": {
    "singularName": "car",
    "pluralName": "cars",
    "displayName": "Auto (Vehicle)"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "car_model": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::car-model.car-model",
      "inversedBy": "cars"
    },
    "vehicle_type": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::vehicle-type.vehicle-type",
      "inversedBy": "cars"
    },
    "variant": {
      "type": "string"
    },
    "price": {
      "type": "integer",
      "required": true,
      "min": 0
    },
    "year": {
      "type": "integer",
      "required": true,
      "min": 1950,
      "max": 2100
    },
    "mileage": {
      "type": "integer",
      "required": true,
      "min": 0
    },
    "fuel": {
      "type": "enumeration",
      "enum": [
        "Bensiini",
        "Diesel",
        "Hybridi",
        "Lataushybridi",
        "Sähkö",
        "Mild hybrid",
        "Kaasu"
      ],
      "required": true,
      "default": "Bensiini"
    },
    "transmission": {
      "type": "enumeration",
      "enum": [
        "Automaatti",
        "Manuaali"
      ],
      "required": true,
      "default": "Automaatti"
    },
    "drivetrain": {
      "type": "enumeration",
      "enum": [
        "Etuveto",
        "Takaveto",
        "Neliveto"
      ],
      "default": "Etuveto"
    },
    "powerKw": {
      "type": "integer",
      "min": 0
    },
    "color": {
      "type": "string"
    },
    "inspectedUntil": {
      "type": "string"
    },
    "co2": {
      "type": "integer",
      "min": 0
    },
    "badge": {
      "type": "string",
      "maxLength": 16
    },
    "featured": {
      "type": "boolean",
      "default": false
    },
    "vatDeductible": {
      "type": "boolean",
      "default": false
    },
    "saleStatus": {
      "type": "enumeration",
      "enum": [
        "available",
        "reserved",
        "sold"
      ],
      "default": "available",
      "required": true
    },
    "images": {
      "type": "media",
      "multiple": true,
      "allowedTypes": [
        "images"
      ]
    },
    "highlights": {
      "type": "component",
      "component": "shared.option",
      "repeatable": true
    },
    "equipment": {
      "type": "component",
      "component": "shared.option",
      "repeatable": true
    },
    "extraSpecs": {
      "type": "component",
      "component": "shared.key-value",
      "repeatable": true
    },
    "description": {
      "type": "blocks"
    },
    "registrationNumber": {
      "type": "string",
      "private": true
    },
    "internalNotes": {
      "type": "text",
      "private": true
    }
  }
}
